      },
      "(Ljava/lang/String;ILjava/lang/String;)V": {
        "newDesc": "(Ljava/lang/String;ILnet/minecraft/client/KeyMapping$Category;)V",
        "transforms": [
          {
            "slot": 2,
            "via": [
              "foxgrade/shim/CtorShims",
              "keyCategory",
              "(Ljava/lang/String;)Lnet/minecraft/client/KeyMapping$Category;"
            ]
